    {
      "id": 16,
      "title": "hello-api p95 latency by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"hello-api\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "datasource": {
