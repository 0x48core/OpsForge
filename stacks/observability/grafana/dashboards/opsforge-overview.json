        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "CPU by container",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
