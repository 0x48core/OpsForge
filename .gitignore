.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
.terraform.lock.hcl.bak

# Ansible
*.retry

# Backups / dumps
*.sql
*.sql.gz
*.dump
*.tar.gz

# Build output
bin/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Traefik local certs and dashboard users
stacks/traefik/certs/*
!stacks/traefik/certs/.gitkeep
stacks/traefik/secrets/*
