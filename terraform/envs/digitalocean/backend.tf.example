# Remote state in a DigitalOcean Spaces bucket (S3-compatible). Copy to backend.tf,
# create the bucket and a Spaces access key first, then:
#   export AWS_ACCESS_KEY_ID=<spaces key> AWS_SECRET_ACCESS_KEY=<spaces secret>
#   terraform init -migrate-state
# Free alternative: HCP Terraform (cloud { organization = "...", workspaces { name = "opsforge" } }).
terraform {
  backend "s3" {
    endpoints = {
      s3 = "https://sgp1.digitaloceanspaces.com"
    }
    bucket = "<your-bucket>"
    key    = "opsforge/digitalocean.tfstate"
    region = "us-east-1" # ignored by Spaces, required by the S3 backend

    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_region_validation      = true
    skip_s3_checksum            = true
  }
}
